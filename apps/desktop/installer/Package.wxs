<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- Stable UpgradeCode — do not change across releases or upgrades break. -->
  <Package
    Name="AgentR"
    Manufacturer="AgentR"
    Version="$(ProductVersion)"
    UpgradeCode="8F3C6E91-2A4B-4D71-9E15-6C8A1B0D4F27"
    Scope="perMachine"
    Compressed="yes">

    <SummaryInformation
      Description="AgentR desktop tray — Teams ↔ local agent CLI bridge"
      Manufacturer="AgentR" />

    <MajorUpgrade
      DowngradeErrorMessage="A newer version of [ProductName] is already installed. Remove it first if you need to downgrade." />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="AgentR" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="AgentR" />
    </StandardDirectory>

    <Feature Id="Main" Title="AgentR" Level="1">
      <Files Directory="INSTALLFOLDER" Include="!(bindpath.PublishDir)\**">
        <Exclude Files="!(bindpath.PublishDir)\**\*.pdb" />
        <Exclude Files="!(bindpath.PublishDir)\**\*.xml" />
      </Files>

      <Component Id="StartMenuShortcut" Directory="ApplicationProgramsFolder" Guid="B7E2A914-5C3D-4F80-9A16-2E4D8C7B1A05">
        <Shortcut
          Id="AgentRStartMenu"
          Name="AgentR"
          Description="Open AgentR settings"
          Target="[INSTALLFOLDER]AgentR.exe"
          WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveProgramMenuDir" Directory="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue
          Root="HKCU"
          Key="Software\AgentR"
          Name="Installed"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>
    </Feature>
  </Package>
</Wix>
